# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# ChromaDB
CHROMA_PERSIST_DIR=./src/knowledge/data/chroma_db
COLLECTION_NAME=fitness_knowledge

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Hugging Face (opcional — solo si descargas hits rate-limit)
# HF_TOKEN=hf_...

# Bot de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=    # CSV de chat IDs autorizados, ej: 123456789,987654321
TELEGRAM_ADMIN_CHAT_ID=        # chat ID que recibe errores críticos del bot
